        <mxCell id="input" value="입력 범위 확인·정책 버전 선택·중복 결과 확인&#10;미지원 부분은 미검사로 기록 · 유효 캐시 사용 시 모델 호출 0회" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eaf1fb;strokeColor=#bdc9d8;fontColor=#172b4d;fontFamily=Apple SD Gothic Neo;fontSize=22;fontStyle=0;">
