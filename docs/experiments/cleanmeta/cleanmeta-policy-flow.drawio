        <mxCell id="gate" value="관련 있음·판단 불가·기준 미달의 텍스트 신호&#10;필요한 공통 관찰값과 근거만 추가 확인" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff3db;strokeColor=#bdc9d8;fontColor=#172b4d;fontFamily=Apple SD Gothic Neo;fontSize=22;fontStyle=0;">
