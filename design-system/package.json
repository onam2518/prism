    "tokens": "tokens/tokens.json",
    "theme": "src/theme.css",
    "components": "src"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "keywords": ["design-system", "design-tokens", "react", "prism", "anchor", "axz"]
