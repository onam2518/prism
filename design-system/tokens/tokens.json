    "label":        { "value": "14px", "type": "dimension", "comment": "버튼·탭·칩" },
    "body":         { "value": "15px", "type": "dimension", "comment": "UI 설명·설정" },
    "answer":       { "value": "16px", "type": "dimension", "comment": "답변 본문 — 읽기 우선" },
    "subtitle":     { "value": "18px", "type": "dimension", "comment": "소스 그룹 라벨·카드 헤딩" },
    "heading":      { "value": "22px", "type": "dimension", "comment": "섹션 헤더·모달 타이틀" },
    "heading-lg":   { "value": "28px", "type": "dimension", "comment": "스레드 타이틀·페이지 헤더" },
    "display":      { "value": "36px", "type": "dimension", "comment": "마케팅 섹션 헤더" },
    "display-hero": { "value": "48px", "type": "dimension", "comment": "랜딩 히어로" }
  },
  "lineHeight": {
    "tight":   { "value": "1.17", "type": "number", "comment": "디스플레이" },
    "snug":    { "value": "1.3",  "type": "number", "comment": "헤딩" },
    "normal":  { "value": "1.5",  "type": "number", "comment": "UI" },
    "relaxed": { "value": "1.63", "type": "number", "comment": "답변 본문 — 매거진 리딩" }
  },
  "fontWeight": {
    "regular":  { "value": 400, "type": "fontWeight" },
    "medium":   { "value": 500, "type": "fontWeight" },
    "semibold": { "value": 600, "type": "fontWeight" }
  },
  "radius": {
