  "font": {
    "sans":    { "value": "'FK Grotesk', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif", "type": "fontFamily", "comment": "기본 UI·헤딩" },
    "display": { "value": "'FK Display', 'FK Grotesk', 'Inter', sans-serif", "type": "fontFamily", "comment": "워드마크·최대 히어로만" },
