{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Prism Design System",
    "description": "Prism UI 디자인 토큰 — Perplexity 정렬(따뜻한 페이퍼 + Peacock teal · 라이트 우선 · 페이퍼-플랫 깊이). 라이트가 기본, 다크는 동급의 1급 모드.",
    "version": "0.2.0"
  },
  "color": {
    "primary":        { "value": "#20808d", "type": "color", "comment": "Peacock teal — 유일한 인터랙션/인용 색 (CTA·링크·포커스·활성)" },
    "primary-hover":  { "value": "#1a6873", "type": "color", "comment": "hover" },
    "primary-deep":   { "value": "#13343b", "type": "color", "comment": "pressed·강조·인용 텍스트" },
    "primary-tint":   { "value": "#e5f2f2", "type": "color", "comment": "정보 배경·인용 칩·hover 행" },
    "teal-on-dark":   { "value": "#34b4c4", "type": "color", "comment": "다크 캔버스용 밝힌 teal" },

    "ink":            { "value": "#091717", "type": "color", "comment": "본문/헤딩 — teal기 도는 near-black, #000 금지" },
