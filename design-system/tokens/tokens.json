    "md":   { "value": "10px",   "type": "dimension", "comment": "버튼·입력·소스 카드" },
    "lg":   { "value": "12px",   "type": "dimension", "comment": "답변/피드 카드" },
    "xl":   { "value": "16px",   "type": "dimension", "comment": "컴포저 웰·모달" },
    "full": { "value": "9999px", "type": "dimension", "comment": "포커스 핀·토글" }
  },
  "space": {
    "1":  { "value": "4px",  "type": "dimension" },
    "2":  { "value": "8px",  "type": "dimension" },
    "3":  { "value": "12px", "type": "dimension" },
    "4":  { "value": "16px", "type": "dimension" },
    "5":  { "value": "20px", "type": "dimension" },
    "6":  { "value": "24px", "type": "dimension" },
    "8":  { "value": "32px", "type": "dimension" },
    "12": { "value": "48px", "type": "dimension" },
    "16": { "value": "64px", "type": "dimension", "comment": "섹션 간격" }
  },
  "shadow": {
    "ambient":  { "value": "0 1px 3px rgba(9,23,23,0.06)",   "type": "shadow", "comment": "컴포저 rest" },
    "subtle":   { "value": "0 1px 2px rgba(9,23,23,0.05)",   "type": "shadow", "comment": "소스 카드·입력 rest" },
    "standard": { "value": "0 2px 8px rgba(9,23,23,0.08)",   "type": "shadow", "comment": "hover 카드·팝오버" },
    "elevated": { "value": "0 4px 16px rgba(9,23,23,0.12)",  "type": "shadow", "comment": "드롭다운·메뉴·토스트" },
    "modal":    { "value": "0 16px 48px rgba(9,23,23,0.20)", "type": "shadow", "comment": "다이얼로그·커맨드 팔레트" }
  },
  "focus": {
    "ring":       { "value": "0 0 0 3px rgba(32,128,141,0.12)", "type": "shadow", "comment": "teal 포커스 링" },
    "ring-error": { "value": "0 0 0 3px rgba(224,82,74,0.12)",  "type": "shadow" }
  },
  "motion": {
    "fast":          { "value": "120ms", "type": "duration", "comment": "hover·포커스·버튼 press" },
    "standard":      { "value": "220ms", "type": "duration", "comment": "카드 lift·팝오버·탭 전환" },
    "slow":          { "value": "360ms", "type": "duration", "comment": "모달·드로어" },
    "ease-standard": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" },
    "ease-enter":    { "value": "cubic-bezier(0, 0, 0.2, 1)",   "type": "cubicBezier" },
    "ease-exit":     { "value": "cubic-bezier(0.4, 0, 1, 1)",   "type": "cubicBezier" }
  }
}
