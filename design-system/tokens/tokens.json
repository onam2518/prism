    "success": { "value": "#1f9d6b", "type": "color" },
    "error":   { "value": "#e0524a", "type": "color" },
    "warning": { "value": "#d9923a", "type": "color" },
    "on-primary": { "value": "#ffffff", "type": "color", "comment": "teal 위 텍스트" }
