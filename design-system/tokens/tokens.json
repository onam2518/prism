{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Prism Design System",
    "description": "Prism UI 디자인 토큰 — Upstage 정렬 다크 테마",
    "version": "0.1.0"
  },
  "color": {
    "violet":        { "value": "#5b52ff", "type": "color", "comment": "유일한 인터랙션 색 (CTA·링크·활성)" },
    "violet-hover":  { "value": "#4a42e0", "type": "color" },
    "violet-deep":   { "value": "#281ca5", "type": "color" },
    "solar":         { "value": "#d2ff95", "type": "color", "comment": "단일 액센트 — 상단 배너 한 곳만" },
    "canvas":        { "value": "#0b0a0f", "type": "color", "comment": "다크 캔버스" },
    "surface":       { "value": "#141318", "type": "color", "comment": "카드 표면" },
    "surface-2":     { "value": "#1a1922", "type": "color" },
    "heading":       { "value": "#ffffff", "type": "color", "comment": "헤딩(다크 위)" },
    "body":          { "value": "#9aa0aa", "type": "color", "comment": "본문(다크 위)" },
    "muted":         { "value": "#6e7191", "type": "color", "comment": "라벨·뮤트" },
    "border":        { "value": "rgba(255,255,255,0.08)", "type": "color", "comment": "헤어라인" },
    "border-strong": { "value": "rgba(255,255,255,0.10)", "type": "color" },
    "success":       { "value": "#34d399", "type": "color" },
    "danger":        { "value": "#fb7185", "type": "color" },
    "warning":       { "value": "#fbbf24", "type": "color" }
  },
  "font": {
    "sans": { "value": "Geist, system-ui, sans-serif", "type": "fontFamily" },
    "mono": { "value": "\"Geist Mono\", monospace", "type": "fontFamily" }
  },
  "fontSize": {
    "xs":   { "value": "12px", "type": "dimension" },
    "sm":   { "value": "13px", "type": "dimension" },
    "base": { "value": "14px", "type": "dimension" },
    "md":   { "value": "15px", "type": "dimension" },
    "lg":   { "value": "18px", "type": "dimension" },
    "xl":   { "value": "24px", "type": "dimension" },
    "2xl":  { "value": "30px", "type": "dimension" }
  },
  "fontWeight": {
    "regular":  { "value": 400, "type": "fontWeight" },
    "medium":   { "value": 500, "type": "fontWeight" },
    "semibold": { "value": 600, "type": "fontWeight" }
  },
  "radius": {
    "none":    { "value": "0px",    "type": "dimension", "comment": "레이아웃 (이진 radius)" },
    "control": { "value": "8px",    "type": "dimension", "comment": "누를 수 있는 요소 (이진 radius)" },
    "lg":      { "value": "12px",   "type": "dimension" },
    "full":    { "value": "9999px", "type": "dimension" }
  },
  "space": {
    "1": { "value": "4px",  "type": "dimension" },
    "2": { "value": "8px",  "type": "dimension" },
    "3": { "value": "12px", "type": "dimension" },
    "4": { "value": "16px", "type": "dimension" },
    "5": { "value": "20px", "type": "dimension" },
    "6": { "value": "24px", "type": "dimension" },
    "8": { "value": "32px", "type": "dimension" }
  },
  "shadow": {
    "none": { "value": "none", "type": "shadow", "comment": "그림자 없음 — 깊이는 surface 대비 + 헤어라인" }
  }
}
